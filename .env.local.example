# Airtable credentials for the Partner Inquiry form (/partners)
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Your Airtable Personal Access Token
# Create one at: https://airtable.com/create/tokens
# Required scope: data.records:write
AIRTABLE_TOKEN=your_airtable_pat_here

# Airtable Base/App ID
AIRTABLE_BASE_ID=appeelJ8gPIe2MO2J

# Exact table name (case-sensitive)
AIRTABLE_TABLE_NAME=Sponsorship Inquires
